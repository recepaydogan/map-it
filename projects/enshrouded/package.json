{
  "name": "enshrouded-map",
  "author": "rastudio",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "description": "Enshrouded Companion with an interactive map and connected game guides.",
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:position-reader",
    "watch": "npm run build:position-reader && npm run build:icons && vite build --watch",
    "build": "npm run build:position-reader && npm run build:icons && node scripts/export-app-locales.mjs && tsc -b && vite build --outDir .dev-build && node scripts/sync-dev-build.mjs",
    "build:position-reader": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-position-reader.ps1",
    "lint": "eslint .",
    "test:launch": "node --experimental-strip-types --test src/background/background-controller.test.mjs src/features/overlay/overlay-preferences.test.mjs src/features/settings/launch-preferences.test.mjs src/overwolf-utils/game-launch-monitor-switch.test.mjs src/overwolf-utils/window-lifecycle.test.mjs",
    "test:position": "node --test src/features/live-position/live-position.test.mjs",
    "test:localization": "node --experimental-strip-types --test src/i18n/game-dictionary.test.mjs src/i18n/app-locales.test.mjs src/i18n/content-search.test.mjs src/i18n/linked-content.test.mjs src/i18n/wiki-table-text.test.mjs src/i18n/fetch-locale-json.test.mjs && python scripts/test-extract-enshrouded-locales.py",
    "test:localization:release": "npm run test:localization && node scripts/audit-localization.mjs && node --experimental-strip-types --test src/i18n/locale-packs.test.mjs",
    "audit:localization": "node scripts/audit-localization.mjs",
    "extract:locales": "python scripts/extract-enshrouded-locales.py",
    "preview": "vite preview",
    "build:icons": "node scripts/build-icons.mjs",
    "build:placeholder-brand": "node scripts/build-placeholder-brand.mjs",
    "build:uninstall-survey": "node --experimental-strip-types scripts/build-uninstall-survey.mjs",
    "build:map-from-tiles": "node scripts/build-map-from-tiles.mjs",
    "build:opk": "node scripts/build-opk.mjs",
    "bump-version": "node scripts/bump-version.mjs",
    "validate:manifest": "node --experimental-strip-types scripts/validate-manifest.mjs",
    "test:position:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-position-reader.ps1"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.1.18",
    "flag-icons": "7.5.0",
    "i18next": "^26.3.4",
    "lucide-react": "^0.563.0",
    "posthog-js": "^1.415.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@eslint/js": "^9.39.1",
    "@overwolf/types": "^3.24.10",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.35.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
