{
  "name": "gta-6-interactive-map",
  "author": "rastudio",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "description": "GTA 6 interactive map companion for Overwolf.",
  "scripts": {
    "dev": "vite",
    "watch": "npm run build:icons && vite build --watch",
    "build": "npm run build:icons && tsc -b && vite build --outDir .dev-build && node scripts/sync-app-build.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:icons": "node scripts/build-icons.mjs",
    "build:opk": "node scripts/package-app.mjs",
    "build:uninstall-survey": "node --experimental-strip-types scripts/build-uninstall-survey.mjs",
    "bump-version": "node scripts/bump-version.mjs",
    "validate:manifest": "node --experimental-strip-types scripts/validate-app-manifest.mjs",
    "publish:content": "node scripts/publish-release-content.mjs",
    "import:map": "node scripts/import-gta6-map.mjs",
    "verify:map": "node scripts/verify-gta6-map.mjs",
    "import:wiki": "node scripts/import-gta6-wiki.mjs",
    "verify:wiki": "node scripts/verify-gta6-wiki.mjs",
    "import:media": "node scripts/import-gta6-media.mjs && node scripts/import-gta6-descriptions.mjs && node scripts/import-gta6-map.mjs",
    "import:descriptions": "node scripts/import-gta6-descriptions.mjs && node scripts/import-gta6-map.mjs",
    "import:marker-artwork": "node scripts/import-gta6-marker-artwork.mjs && node scripts/import-gta6-map.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.1.18",
    "i18next": "^26.3.4",
    "lucide-react": "^0.563.0",
    "posthog-js": "^1.415.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@eslint/js": "^9.39.1",
    "@overwolf/types": "^3.24.10",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.35.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
