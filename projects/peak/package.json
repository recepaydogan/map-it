{
  "name": "peak-map",
  "private": true,
  "version": "2.0.4",
  "type": "module",
  "description": "Peak Map, an Overwolf map companion for PEAK.",
  "scripts": {
    "dev": "vite --open /app.html",
    "build": "tsc -b && vite build --mode production",
    "build:overwolf": "tsc -b && vite build --mode overwolf",
    "build:opk": "npm run build:overwolf && node scripts/pack-opk.mjs",
    "bump-version": "node scripts/bump-version.mjs",
    "watch": "vite build --watch --mode overwolf",
    "preview": "vite preview",
    "build:icons": "node scripts/build-icons.mjs",
    "build:screenshots": "node scripts/build-screenshots.mjs",
    "build:uninstall-survey": "node scripts/build-uninstall-survey.mjs",
    "test:uninstall": "node --test scripts/uninstall-tests/*.test.mjs",
    "setup:peak-data": "py -3 -m pip install -r scripts/peak-data/requirements.txt",
    "extract:peak-data": "py -3 scripts/scan-peak-game-data.py",
    "scan:peak-game-data": "py -3 scripts/scan-peak-game-data.py",
    "check:peak-maps": "node scripts/check-peak-map-compatibility.mjs",
    "upload:peak-cdn": "node scripts/upload-peak-cdn.mjs",
    "render:peak-maps": "py -3 scripts/render-peak-maps.py",
    "extract:peak-content": "py -3 scripts/extract-peak-data.py --content-only",
    "extract:peak-icons": "py -3 scripts/extract-peak-data.py --icons-only",
    "extract:peak-item-icons": "py -3 scripts/extract-peak-data.py --item-icons-only",
    "validate:peak-data": "node scripts/validate-peak-data.mjs",
    "lint": "eslint .",
    "test:support": "node scripts/test-header-support-control.mjs && node scripts/test-support-store.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.18",
    "i18next": "^26.3.4",
    "lucide-react": "^0.563.0",
    "posthog-js": "^1.417.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@overwolf/types": "^3.24.10",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
