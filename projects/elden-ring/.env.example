# Copy to .env to serve the big extracted image sets from the CDN (loaded by Vite in
# all modes and by scripts/build-opk.mjs). The item icons, boss portraits and TEST MAP
# enemy portraits live in the ER-Atlas-Assets repo, served via jsDelivr — set the base
# to that repo at an immutable @tag.
#   Unset → icons load locally from /public (only if those folders are present).
#   Set   → bundle points at the CDN, and `npm run build:opk` drops them from the OPK.
VITE_ASSET_BASE=https://cdn.jsdelivr.net/gh/<user>/<repo>@v4

# ── Accounts (Supabase) ──────────────────────────────────────────────────────
# Sign-in / sign-up / Google OAuth. Both vars must be set for account features to
# light up — when either is missing the app boots fine and just hides the Account
# screen (status "unavailable"). Find these under Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
# Google sign-in returns through a custom URL protocol. Allow-list this exact
# value under Supabase → Auth → URL Configuration → Redirect URLs:
#   eldenringatlas://auth/callback

# ── Analytics (PostHog) ──────────────────────────────────────────────────────
# Product analytics: pageviews (per surface) + sign-in/out events. Optional —
# with no key the app runs fine and simply tracks nothing. Initialized once, in
# the main window only. Find the key under PostHog → Settings → Project. Host is
# https://us.i.posthog.com (US) or https://eu.i.posthog.com (EU); defaults to US.
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Analytics (Google Analytics 4) — WEBSITE ONLY ────────────────────────────
# GA4 measurement id (Admin → Data Streams → Web). Only the public website
# (landing pages + /map) reports here; the Overwolf app never loads gtag, so
# in-app pageviews/events stay in PostHog. Optional — unset = no GA.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
