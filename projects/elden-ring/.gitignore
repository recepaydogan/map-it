# Build artifacts
*.opk
*.zip

# CDN-hosted assets — the extracted item icons and the boss/enemy portraits live
# in the ER-Atlas-Assets repo (served via jsDelivr), not here. The extractors may
# still write them locally, but they must not be re-committed into this repo.
public/icons/elden-ring/items/
public/icons/elden-ring/enemies/
public/icons/elden-ring/bosses/
public/icons/nightreign/bosses/

# Full-res map source images — inputs to scripts/build-map-tiles.mjs only. The
# shipped artifact is the generated tile pyramid (public/maps/tiles/), already
# committed; these 44MB sources are kept locally for re-tiling, never in the repo.
map-sources/

# NR archive item icons — streamed from the CDN (ER-Atlas-Assets), category
# fallback glyph when offline. See src/utils/assets.ts nrItemIconUrl.
public/icons/nightreign/items/
