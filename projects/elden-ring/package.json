{
  "name": "elden-ring-atlas",
  "private": true,
  "version": "2.1.5",
  "type": "module",
  "description": "Elden Ring Atlas — interactive maps, bosses, items & live tracking for Elden Ring & Nightreign (Overwolf app).",
  "scripts": {
    "dev": "vite --open /app.html",
    "build": "npm run build:web",
    "build:web": "tsc -b && vite build --mode production && node scripts/build-seo-database.mjs && node scripts/build-seo-pages.mjs && node scripts/build-cloudflare-routing.mjs",
    "build:save-reader": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-save-reader.ps1",
    "build:overwolf": "npm run build:save-reader && tsc -b && vite build --mode overwolf",
    "watch": "npm run build:save-reader && vite build --watch --mode overwolf",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:web": "vite preview",
    "build:icons": "node scripts/build-icons.mjs",
    "build:store-tile": "node scripts/build-store-tile.mjs",
    "build:store-icon": "node scripts/build-store-icon.mjs",
    "build:store-screenshots": "node scripts/build-store-screenshots.mjs",
    "build:er-map": "node data/src/build-er-map-params.mjs",
    "build:er-map:i18n": "node data/src/build-er-map-i18n.mjs",
    "build:er-weapon-advisor": "node data/src/build-er-weapon-advisor.mjs",
    "extract:er-map:spatial": "node data/src/extract-er-spatial.mjs",
    "build:er-map:spatial": "node data/src/build-er-map-spatial.mjs",
    "audit:er-combat-drops": "node data/src/audit-er-combat-drops.mjs",
    "audit:er-build-advisor": "node scripts/audit-er-build-advisor.mjs",
    "audit:er-build-advisor:matrix": "node scripts/audit-er-build-advisor-matrix.mjs",
    "build:fallbacks": "node scripts/build-fallback-icons.mjs",
    "build:opk": "node scripts/build-opk.mjs",
    "validate": "node scripts/validate-manifest.mjs && npm run validate:schema",
    "validate:seo": "node scripts/validate-seo.mjs",
    "validate:schema": "ajv validate -s schema/overwolf-manifest-schema.json -d public/manifest.json -c ajv-formats --strict=false --all-errors",
    "bump-version": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.1.18",
    "@vercel/analytics": "^2.0.1",
    "country-flag-icons": "^1.6.19",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.563.0",
    "posthog-js": "^1.395.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@overwolf/types": "^3.24.10",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
