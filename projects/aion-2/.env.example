# Copy this file to `.env` and fill it in. The CDN origin is required for every
# dev, watch, and build run. Account and analytics values remain optional.
#
# Vite bakes these into the bundle AT BUILD TIME — restart `npm run dev` or
# rebuild the .opk after changing them.
# ── Supabase (accounts: sign in / sign up / password reset / Google OAuth) ──
# Each app gets its OWN Supabase project. Dashboard → Project Settings →
# Data API (Project URL) and API Keys (anon / public). Both are safe to ship in
# the client bundle: the anon key is public by design and every table must be
# protected by row-level security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase dashboard setup for this app:
#   Authentication → URL Configuration → Redirect URLs — add exactly
#     <protocolScheme>://auth/callback       (see GAME_CONFIG.protocolScheme)
#   plus http://localhost:5173 for plain-browser development.
#   Authentication → Sign In / Providers → Google — enable it with a Google
#     Cloud "Web application" OAuth client whose authorised redirect URI is
#     https://<your-project-ref>.supabase.co/auth/v1/callback
#   Authentication → Emails → Reset Password — the template must contain the
#     6-digit {{ .Token }}: Overwolf windows cannot receive redirect links, so
#     the in-app reset verifies the code.
#   Authentication → Emails → SMTP — optional custom sender (e.g. Resend:
#     host smtp.resend.com, port 465, user "resend", password = API key).

# ── PostHog analytics (optional) ────────────────────────────────────────────
# Project Settings → Project API key (phc_...). A public ingestion key, not a
# secret. Leave unset to disable analytics entirely.
VITE_POSTHOG_KEY=phc_your-project-api-key
# Only if the project is NOT on the default US cloud:
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Optional source map upload for production builds. These values are read by
# Vite on the build machine only; never prefix them with VITE_. Create a
# personal API key with error tracking write and organization read access, and
# get the numeric project ID from PostHog project settings. Configure both or
# neither. Successful uploads remove source maps from the app bundle.
# POSTHOG_API_KEY=your-personal-api-key
# POSTHOG_PROJECT_ID=your-project-id
# The standard EU ingestion host above automatically selects the EU API host.
# Set POSTHOG_HOST only for a custom PostHog instance.
# POSTHOG_HOST=https://your-posthog-instance.example.com

# ── Release content on Cloudflare R2 ────────────────────────────────────────
# Keep all R2 credentials server-side: never prefix them with VITE_.
# All app modes load public/data and public/maps from the immutable CDN release
# matching the local content. Run build:opk to publish new content first.
# The credentials are needed to publish with build:opk, not to run dev/watch/build.
# Use a custom domain attached to the bucket for production.
R2_PUBLIC_ORIGIN=https://assets.example.com
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-bucket-scoped-access-key-id
# R2_SECRET_ACCESS_KEY=your-bucket-scoped-secret-access-key
# R2_BUCKET=your-app-content-bucket
# R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# Public Tebex store token for this app. Never expose private/webhook keys in VITE_ variables.
VITE_TEBEX_PUBLIC_TOKEN=
# Enable only after deploying the optional subscriber ledger in this app's Supabase project.
VITE_SUBSCRIBER_LEDGER_ENABLED=false
