{
  "name": "valheim-map",
  "private": true,
  "version": "4.1.5",
  "type": "module",
  "description": "Reusable Overwolf foundation for a Valheim companion app.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "watch": "vite build --watch",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:icons": "node scripts/build-icons.mjs",
    "build:opk": "node scripts/build-opk.mjs",
    "bump-version": "node scripts/bump-version.mjs",
    "validate:opk-files": "node scripts/validate-opk-files.mjs",
    "extract:asset-index": "node scripts/extract-asset-index.mjs",
    "setup:data-tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-data-tools.ps1",
    "extract:game-data": "npm run extract:asset-index && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/extract-game-data.ps1 && npm run build:nearby-creatures",
    "build:nearby-creatures": "node scripts/build-nearby-creature-catalog.mjs",
    "extract:location-contents": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/extract-location-contents.ps1 && npm run extract:dungeon-search",
    "extract:dungeon-search": ".venv\\Scripts\\python.exe tools/extract-dungeon-search.py",
    "export:static-icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-static-icons.ps1",
    "export:map-textures": ".venv\\Scripts\\python.exe tools/export-map-textures.py",
    "build:map-data": "node scripts/build-map-data.mjs",
    "extract:building-data": "python tools/extract-building-data.py",
    "build:building-catalog": "node scripts/build-building-catalog.mjs",
    "validate:game-data": "node scripts/validate-game-data.mjs",
    "validate:world-generator": "node --experimental-strip-types scripts/validate-world-generator.mjs",
    "extract:fast-noise-vectors": "node scripts/extract-fast-noise-vectors.mjs",
    "generate:seed": "node --experimental-strip-types scripts/generate-seed-locations.mjs",
    "extract:all-static-data": "npm run extract:game-data && npm run extract:location-contents && npm run export:static-icons && npm run build:map-data && npm run validate:game-data",
    "setup:decompiler": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-decompiler.ps1",
    "extract:game-code": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/decompile-game.ps1",
    "extract:world-saves": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/extract-world-saves.ps1",
    "test:planner": "node --experimental-strip-types --test scripts/planner-tests/*.test.ts",
    "test:building": "node --experimental-strip-types --test scripts/building-tests/*.test.ts",
    "test:map": "node --experimental-strip-types --test scripts/map-tests/*.test.ts",
    "test:hotkeys": "node --experimental-strip-types --test scripts/hotkey-tests/*.test.ts",
    "test:tracking": "node --experimental-strip-types --test scripts/tracking-tests/*.test.ts",
    "test:uninstall": "node --test scripts/uninstall-tests/*.test.mjs",
    "build:tracking-mod": "dotnet build tracking-mod/valheim-companion-position.csproj -c Release && node scripts/copy-tracking-mod.mjs",
    "build:local-exploration": "dotnet build tracking-exploration/valheim-local-exploration.csproj -c Release && node scripts/copy-local-exploration.mjs",
    "test:local-exploration-bridge": "dotnet run --project scripts/tracking-tests/local-exploration/LocalExplorationChecks.csproj -c Release",
    "validate": "node scripts/validate-manifest.mjs && npm run validate:schema",
    "validate:schema": "node scripts/validate-manifest-schema.mjs",
    "test:support": "node scripts/test-header-support-control.mjs && node scripts/test-support-store.mjs",
    "upload:assets": "node scripts/upload-assets-cdn.mjs",
    "prepare:cdn": "node scripts/prepare-cdn-assets.mjs",
    "prebuild": "npm run prepare:cdn",
    "predev": "npm run prepare:cdn",
    "prewatch": "npm run prepare:cdn",
    "test:cdn": "node scripts/test-asset-cdn.mjs",
    "test:locales": "node scripts/test-locales.mjs",
    "test:subscriptions": "node --experimental-strip-types --test src/features/subscriptions/*.test.mjs supabase/functions/sync-premium-subscriber/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.18",
    "flag-icons": "^7.5.0",
    "i18next": "^26.3.4",
    "lucide-react": "^0.563.0",
    "posthog-js": "^1.417.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@eslint/js": "^9.39.1",
    "@overwolf/types": "^3.24.10",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.1.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.35.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
