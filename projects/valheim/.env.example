# Copy to .env and fill in. Every var below is optional: with none of them set
# the app boots and works exactly as before — account features simply report
# "unavailable" and analytics tracks nothing.

# ── Accounts (Supabase) ──────────────────────────────────────────────────────
# Sign-in / sign-up / Google OAuth. Both vars must be set for account features to
# light up — when either is missing the app boots fine and just hides the Account
# screen (status "unavailable"). Find these under Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
# Google sign-in returns through the valheimcompanion:// URL protocol declared in
# public/manifest.json. Allow-list this exact value under
# Supabase → Auth → URL Configuration → Redirect URLs:
#   valheimcompanion://auth/callback

# ── Analytics (PostHog) ──────────────────────────────────────────────────────
# Product analytics. Optional — with no key the app runs fine and tracks nothing.
# Find the key under PostHog → Settings → Project. Host is https://us.i.posthog.com
# (US) or https://eu.i.posthog.com (EU); defaults to US.
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_ENABLED=false

# Asset publishing only; never prefix these secrets with VITE_.
# Existing published CDN URLs are committed; these are needed only for uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
ASSET_CDN_ORIGIN=https://pz.ingredientassets.com

# RA Studio Apps public store token (never a private/server key).
VITE_TEBEX_PUBLIC_TOKEN=
# Enable only after deploying the ledger functions to the Valheim Supabase project.
VITE_SUBSCRIBER_LEDGER_ENABLED=false
