{
  "name": "wow-forever-map",
  "author": "rastudio",
  "private": true,
  "version": "5.0.2",
  "type": "module",
  "description": "World of Warcraft map app shell with reusable dashboard, panels, overlays and tile rendering.",
  "scripts": {
    "dev": "vite",
    "watch": "npm run build:icons && vite build --watch",
    "test:character-sync": "node --test src/features/character-sync/addon-install-action.test.mjs src/features/character-sync/character-sync-service.test.mjs src/features/character-sync/character-switch-integration.test.mjs src/features/character-sync/saved-character-merge.test.mjs src/features/character-sync/character-snapshot.test.mjs src/features/character-sync/character-sync-store.test.mjs",
    "test:tracking": "node --test src/features/live-position/gep-data-source.test.mjs src/features/live-position/position-addon-installer.test.mjs src/features/live-position/position-projection.test.mjs scripts/no-memory-reader.test.mjs scripts/position-addon-release.test.mjs",
    "publish:position-addon": "node scripts/publish-position-addon.mjs",
    "build": "npm run build:icons && tsc -b && vite build",
    "build:subscriptions-test": "npm run build:icons && tsc -b && vite build --mode subscriptions-test --outDir dist",
    "test:subscriptions": "node --experimental-strip-types --test src/features/subscriptions/subscription-controller.test.mjs src/features/subscriptions/subscription-callback.test.mjs src/features/subscriptions/subscription-quarterly.test.mjs src/features/subscriptions/subscription-translations.test.mjs supabase/functions/sync-premium-subscriber/handler.test.mjs src/features/subscriptions/regional-prices.test.mjs",
    "lint": "eslint .",
    "test:launch": "node --experimental-strip-types --test src/background/background-controller.test.mjs src/features/settings/launch-preferences.test.mjs src/overwolf-utils/game-launch-monitor-switch.test.mjs",
    "test:updates": "node --test src/features/updates/use-auto-open-updates.test.mjs src/features/updates/use-update-read-state.test.mjs src/features/updates/updates-release.test.mjs",
    "test:quest-markers": "node scripts/sync-quest-marker-details.mjs --check",
    "test:profession-leveling": "node scripts/build-profession-leveling-guides.mjs --check && node --test scripts/profession-leveling-guides.test.mjs",
    "preview": "vite preview",
    "build:icons": "node scripts/build-icons.mjs",
    "build:uninstall-survey": "node --experimental-strip-types scripts/build-uninstall-survey.mjs",
    "build:map-from-tiles": "node scripts/build-map-from-tiles.mjs",
    "research:client": "node scripts/refresh-client-research.mjs",
    "research:repair-vendors-client": "node scripts/audit-client-repair-vendors.mjs",
    "research:repair-vendors-deep": "node scripts/scan-client-repair-vendors-deep.mjs",
    "research:profession-trainers": "node scripts/audit-client-profession-trainers.mjs",
    "research:profession-binary-gaps": "node scripts/audit-client-profession-binary-gaps.mjs",
    "research:trainer-data-paths": "node scripts/audit-client-trainer-data-paths.mjs",
    "research:profession-venues": "node scripts/trace-client-profession-venues.mjs",
    "build:opk": "node scripts/build-opk.mjs",
    "publish:locales": "node scripts/publish-locale-content.mjs --upload",
    "preview:locales": "node scripts/publish-locale-content.mjs --dry-run",
    "bump-version": "node scripts/bump-version.mjs",
    "validate:manifest": "node --experimental-strip-types scripts/validate-manifest.mjs",
    "build:map-search": "node --experimental-strip-types scripts/build-map-item-search.mjs",
    "test:map-search": "node --test scripts/map-search.test.mjs scripts/map-search-worker.test.mjs",
    "benchmark:map-search": "node scripts/benchmark-map-search.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tesseract.js-data/eng": "1.0.0",
    "flag-icons": "^7.6.0",
    "i18next": "^26.3.4",
    "lucide-react": "^0.563.0",
    "posthog-js": "^1.415.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tesseract.js": "7.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@eslint/js": "^9.39.1",
    "@jamiephan/casclib": "0.1.0",
    "@overwolf/types": "^3.24.10",
    "@rhyster/wow-casc-dbc": "2.16.11",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "js-blp": "1.0.5",
    "sharp": "^0.35.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
