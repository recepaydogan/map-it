{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pzim.local/schema/community-map-package.schema.json",
  "title": "Project Zomboid Map Community Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageType",
    "id",
    "version",
    "displayName",
    "creator",
    "rights",
    "supportedGameBuilds",
    "map"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageType": { "const": "pzim-community-map" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$", "maxLength": 40 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sourceUrl"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sourceUrl": { "type": "string", "format": "uri", "maxLength": 500 }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license", "permissionStatus", "attribution"],
      "properties": {
        "license": { "type": "string", "minLength": 1, "maxLength": 120 },
        "licenseUrl": { "type": "string", "format": "uri", "maxLength": 500 },
        "permissionStatus": { "enum": ["self-authored", "explicit"] },
        "permissionEvidenceUrl": { "type": "string", "format": "uri", "maxLength": 500 },
        "attribution": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "allOf": [
        {
          "if": { "properties": { "permissionStatus": { "const": "explicit" } } },
          "then": {
            "properties": { "permissionEvidenceUrl": { "type": "string", "format": "uri", "maxLength": 500 } },
            "required": ["permissionEvidenceUrl"]
          }
        }
      ]
    },
    "supportedGameBuilds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^4[12](?:\\.\\d+){0,2}$" }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinateOffset", "bounds", "tileSize", "detailLevels", "tilePattern", "locationsFile"],
      "properties": {
        "coordinateOffset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "integer", "minimum": -100000, "maximum": 100000 },
            "y": { "type": "integer", "minimum": -100000, "maximum": 100000 }
          }
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minX", "minY", "maxX", "maxY"],
          "properties": {
            "minX": { "type": "integer", "minimum": -100000, "maximum": 100000 },
            "minY": { "type": "integer", "minimum": -100000, "maximum": 100000 },
            "maxX": { "type": "integer", "minimum": -100000, "maximum": 100000 },
            "maxY": { "type": "integer", "minimum": -100000, "maximum": 100000 }
          }
        },
        "tileSize": { "type": "integer", "enum": [256, 512, 1024] },
        "detailLevels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 9 }
        },
        "tilePattern": {
          "type": "string",
          "pattern": "^tiles/.*\\{level\\}.*\\{x\\}.*\\{y\\}.*\\.(?:png|webp|jpg)$",
          "maxLength": 240
        },
        "locationsFile": { "type": "string", "pattern": "^[a-zA-Z0-9/_-]+\\.json$", "maxLength": 160 }
      }
    }
  }
}
