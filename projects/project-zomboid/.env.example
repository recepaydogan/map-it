# Supabase project credentials for the account features (sign in / sign up /
# password reset / Google OAuth). Copy this file to `.env` and fill it in.
#
# Both values are safe to ship in the client bundle: the anon key is public by
# design and every table is expected to be protected by row-level security.
#
# Leave them unset and the app still boots — accounts report themselves as
# unavailable and the map keeps working signed-out (see src/data/supabase-client.ts).
#
# Supabase dashboard → Project Settings → Data API / API Keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase dashboard setup ────────────────────────────────────────────────
# Authentication → URL Configuration → Redirect URLs — add exactly:
#     pzinteractivemap://auth/callback
#   Google consent redirects here; the OS hands the URL to Overwolf, which
#   relays it to the app (data.url_protocol.scheme in public/manifest.json).
#   For plain-browser dev also add http://localhost:5173.
#
# Authentication → Sign In / Providers → Google — enable it and paste the
#   client ID/secret from a Google Cloud OAuth "Web application" client whose
#   authorised redirect URI is https://<your-project-ref>.supabase.co/auth/v1/callback
#
# Authentication → Emails → Reset Password — the template must contain the
#   6-digit {{ .Token }} (not only {{ .ConfirmationURL }}): Overwolf windows
#   cannot receive redirect links, so the in-app reset verifies the code.

# ── PostHog analytics (optional) ────────────────────────────────────────────
# Product analytics for the app (pageviews, feature usage, game sessions).
# Leave unset and the app still boots — every analytics call is a silent no-op.
#
# PostHog dashboard → Project Settings → Project API key (phc_...).
# The key is written into the client bundle by design; it is a public write-only
# ingestion key, not a secret.
VITE_POSTHOG_KEY=phc_your-project-api-key
# Only set if your project is NOT on the default US cloud:
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# After provisioning a PostHog managed reverse proxy and verifying its DNS,
# point ingestion at that domain. Keep the UI host on the actual cloud region.
# VITE_POSTHOG_HOST=https://your-neutral-subdomain.example.com
# VITE_POSTHOG_UI_HOST=https://eu.posthog.com

# Public, versioned CDN root for the Knox Country metadata, locales and tiles.
# Leave unset to use the files bundled under public/map-data/knox-country.
VITE_MAP_DATA_BASE_URL=https://pz.ingredientassets.com/b42.20.2-r1/knox-country
