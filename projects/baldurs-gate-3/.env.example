# Copy this file to `.env` and fill it in. Every value is optional: the app
# boots with all of them empty (accounts show as unavailable, analytics is off,
# maps load from the bundled public/maps folder).
#
# Vite bakes these into the bundle AT BUILD TIME — restart `npm run dev` or
# rebuild the .opk after changing them.

# ── Supabase (accounts: sign in / sign up / password reset) ──
# Each app gets its OWN Supabase project. Dashboard → Project Settings →
# Data API (Project URL) and API Keys (anon / public). Both are safe to ship in
# the client bundle: the anon key is public by design and every table must be
# protected by row-level security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase dashboard setup for this app:
#   Authentication → Emails → Reset Password — the template must contain the
#     6-digit {{ .Token }}: Overwolf windows cannot receive redirect links, so
#     the in-app reset verifies the code.
#   Authentication → Emails → SMTP — optional custom sender (e.g. Resend:
#     host smtp.resend.com, port 465, user "resend", password = API key).

# ── PostHog analytics (optional) ────────────────────────────────────────────
# Project Settings → Project API key (phc_...). A public ingestion key, not a
# secret. Leave unset to disable analytics entirely.
VITE_POSTHOG_KEY=phc_your-project-api-key
# Only if the project is NOT on the default US cloud:
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ── Map data (optional) ─────────────────────────────────────────────────────
# Where map folders live (each holding metadata.json + tiles/). Defaults to the
# bundled `/maps`; point it at a CDN for release builds so the .opk stays small.
# VITE_MAP_DATA_BASE_URL=https://cdn.example.com/maps

# Optional imagery-only CDN. Metadata and markers still use MAP_DATA_BASE_URL.
# Activate only after publish-map-images.mjs verifies the release.
# VITE_MAP_IMAGE_BASE_URL=https://cdn.example.com/maps/releases/<release-hash>

# R2 upload credentials: Node scripts only, never prefix these with VITE_.
# R2_ACCOUNT_ID=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
