{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "Map It",
    "version": "1.0.0",
    "minimum-overwolf-version": "0.240.0",
    "author": "rastudio",
    "icon": "icon.png",
    "icon_gray": "icon_gray.png",
    "launcher_icon": "launcher_icon.ico",
    "tray_icon": "launcher_icon.ico",
    "window_icon": "icon.png",
    "description": "Map It brings our game map applications together in one central app."
  },
  "permissions": [
    "DesktopStreaming",
    "Extensions",
    "FileSystem",
    "GameInfo",
    "Hotkeys",
    "Media",
    "Profile",
    "Streaming",
    "Tray",
    "Web"
  ],
  "data": {
    "developer": {
      "enable_auto_refresh": true,
      "reload_delay": 1000
    },
    "start_window": "background",
    "force_browser": "user",
    "url_protocol": {
      "scheme": "mapit"
    },
    "uninstall_window": {
      "file": "uninstall.html",
      "required_runtime": 5000
    },
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [
        8032,
        10598,
        21668,
        21866,
        22088,
        22176,
        23946,
        25918,
        26092,
        28260,
        28268,
        28310,
        28318
      ]
    },
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": {
          "game_ids": [
            8032,
            10598,
            21668,
            21866,
            22088,
            22176,
            23946,
            25918,
            26092,
            28260,
            28268,
            28310,
            28318
