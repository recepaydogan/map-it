        "title": "Toggle Minimap",
        "action-type": "custom",
        "default": "Ctrl+Shift+M"
      },
      "toggle_desktop_app": {
        "title": "Toggle Desktop App",
        "action-type": "custom",
        "default": "Ctrl+A"
      },
      "toggle_app": {
        "title": "Toggle App",
        "action-type": "custom",
        "default": "Ctrl+D"
      },
      "mi_elden-ring_toggle_companion": {
        "title": "Elden Ring / Nightreign: Toggle Roundtable",
        "action-type": "custom",
        "default": "Ctrl+Shift+B"
      },
      "mi_elden-ring_dismiss_overlay": {
        "title": "Elden Ring / Nightreign: Hide Map Overlay",
        "action-type": "custom",
        "default": "Ctrl+Shift+H"
      },
      "mi_minecraft_pin_current_position": {
        "title": "Minecraft: Pin Current Position",
        "action-type": "custom",
        "default": "Ctrl+Alt+P"
      },
      "mi_minecraft_zoom_minimap_in": {
        "title": "Minecraft: Zoom Minimap In",
        "action-type": "custom",
        "default": "Ctrl+Alt+I"
      },
      "mi_minecraft_zoom_minimap_out": {
        "title": "Minecraft: Zoom Minimap Out",
        "action-type": "custom",
        "default": "Ctrl+Alt+O"
      },
      "mi_project-zomboid_move_overlay_up": {
        "title": "Project Zomboid: Move Map Overlay Up",
        "action-type": "custom",
        "default": "Shift+Up",
        "passthrough": true,
        "hold": true
      },
      "mi_project-zomboid_move_overlay_down": {
        "title": "Project Zomboid: Move Map Overlay Down",
        "action-type": "custom",
        "default": "Shift+Down",
        "passthrough": true,
        "hold": true
      },
      "mi_project-zomboid_move_overlay_left": {
        "title": "Project Zomboid: Move Map Overlay Left",
