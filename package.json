{
  "name": "map-it",
  "author": "rastudio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Central Overwolf application base for the Map It collection of game maps.",
  "scripts": {
    "dev": "vite",
    "watch": "npm run build:icons && vite build --watch",
    "build": "node scripts/build-map-it.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:icons": "node scripts/build-icons.mjs",
    "build:opk": "node scripts/build-map-it.mjs --opk",
    "build:uninstall-survey": "node --experimental-strip-types scripts/build-uninstall-survey.mjs",
    "bump-version": "node scripts/bump-version.mjs",
    "validate:manifest": "node --experimental-strip-types scripts/validate-app-manifest.mjs",
    "publish:content": "node scripts/publish-release-content.mjs",
    "import:apps": "node scripts/build-map-it.mjs --import-only",
    "check:apps": "python scripts/import-map-apps.py --check-only",
    "test:build-pipeline": "python scripts/test-app-sync.py && node --test scripts/build-map-it.test.mjs",
    "verify:apps": "node scripts/verify-imported-apps.mjs",
    "verify:library-artwork": "node scripts/verify-library-artwork.mjs",
    "test:hub": "node --experimental-strip-types --test scripts/app-library-runtime.test.mjs scripts/app-launch-router.test.mjs scripts/app-hotkeys.test.mjs scripts/app-startup-selection.test.mjs",
    "prepare:app-content": "node scripts/prepare-app-content.mjs",
    "publish:app-content": "node scripts/publish-app-content.mjs",
    "test:content": "node --test scripts/app-content-runtime.test.mjs",
    "test:assets": "node --test scripts/module-asset-build.test.mjs",
    "audit:assets": "node scripts/audit-app-assets.mjs && node scripts/check-app-asset-urls.mjs",
    "test:account": "node --test scripts/shared-account.test.mjs scripts/shared-account-schema.test.mjs scripts/shared-account-session.test.mjs scripts/shared-account-signout.test.mjs src/services/auth/recovery-code.test.mjs",
    "test:support": "node --test scripts/shared-support-schema.test.mjs scripts/shared-support-client.test.mjs src/features/support/support-time.test.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.1.18",
    "i18next": "^26.3.4",
    "lucide-react": "^0.563.0",
    "posthog-js": "^1.415.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@electric-sql/pglite": "0.5.15",
    "@eslint/js": "^9.39.1",
    "@overwolf/types": "^3.24.10",
    "@smithy/core": "3.37.0",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "acorn": "8.18.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.35.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
